{
  "name": "mujian-blog",
  "version": "1.0.0",
  "private": true,
  "description": "沐简的博客：使用 Eleventy 构建并部署到 GitHub Pages 的中文静态技术博客。",
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "eleventy",
    "check": "node scripts/check-site.mjs",
    "test": "npm run build && npm run check"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@11ty/eleventy-plugin-syntaxhighlight": "5.0.2",
    "markdown-it": "14.3.0",
    "markdown-it-anchor": "9.2.0",
    "mermaid": "11.12.0"
  }
}
