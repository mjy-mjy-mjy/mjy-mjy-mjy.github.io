<article class="article-card{% if post.data.cover and post.data.cover.image %} article-card--cover{% endif %}"{% if post.data.cover and post.data.cover.image %} style="--article-cover: url('{{ post.data.cover.image }}')"{% endif %}>
  {% if post.data.cover and post.data.cover.image %}<div class="article-card__cover" aria-hidden="true"></div>{% endif %}
  <div class="article-card__body">
    <div class="article-card__top">
      <p class="eyebrow">TECHNICAL ESSAY</p>
      <time datetime="{{ post.date | dateIso }}">{{ post.date | dateDisplay }}</time>
    </div>
    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <p>{{ post.data.description }}</p>
    <div class="article-card__meta">
      <span>{{ post.content | readingTime }} 分钟阅读</span>
      {% if post.data.updated %}<span>更新于 {{ post.data.updated | dateDisplay }}</span>{% endif %}
    </div>
    <div class="article-card__footer">
      <ul class="tag-list">
        {% for tag in post.data.tags %}{% if tag != "posts" %}<li><a href="/tags/#{{ tag }}"># {{ tag }}</a></li>{% endif %}{% endfor %}
      </ul>
      <a class="text-link" href="{{ post.url }}">阅读全文 <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>