<article class="article-card">
  <div class="article-card__top">
    <p class="eyebrow">FEATURED ESSAY</p>
    <time datetime="{{ post.date | dateIso }}">{{ post.date | dateDisplay }}</time>
  </div>
  <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
  <p>{{ post.data.description }}</p>
  <div class="article-card__footer">
    <ul class="tag-list">
      {% for tag in post.data.tags %}{% if tag != "posts" %}<li><a href="/tags/#{{ tag }}"># {{ tag }}</a></li>{% endif %}{% endfor %}
    </ul>
    <a class="text-link" href="{{ post.url }}">阅读全文 <span aria-hidden="true">→</span></a>
  </div>
  <span class="article-card__reading">{{ post.content | readingTime }} 分钟阅读</span>
</article>
