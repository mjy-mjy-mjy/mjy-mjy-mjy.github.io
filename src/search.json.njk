---
permalink: /search.json
eleventyExcludeFromCollections: true
---
[
{% for post in collections.posts %}
  {
    "title": {{ post.data.title | jsonify | safe }},
    "url": {{ post.url | jsonify | safe }},
    "description": {{ post.data.description | jsonify | safe }},
    "date": {{ post.date | dateIso | jsonify | safe }},
    "readingTime": {{ post.content | readingTime }},
    "tags": {{ post.data.tags | jsonify | safe }},
    "text": {{ post.content | plainText | jsonify | safe }}
  }{% if not loop.last %},{% endif %}
{% endfor %}
]
