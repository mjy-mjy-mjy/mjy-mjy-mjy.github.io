---
layout: layouts/page.njk
title: 文章归档
eyebrow: ARCHIVE
description: 按时间整理所有技术学习、开发实践与阶段性思考。
permalink: /archive/index.html
---
<div class="archive">
  {% set currentYear = "" %}
  {% for post in collections.posts %}
    {% set postYear = post.date | year %}
    {% if postYear != currentYear %}
      {% if not loop.first %}</ol></section>{% endif %}
      <section class="archive-year">
        <h2>{{ postYear }}</h2>
        <ol>
      {% set currentYear = postYear %}
    {% endif %}
      <li>
        <time datetime="{{ post.date | dateIso }}">{{ post.date | month }} 月 {{ post.date | dateDisplay }}</time>
        <div>
          <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          <p>{{ post.data.description }}</p>
        </div>
      </li>
    {% if loop.last %}</ol></section>{% endif %}
  {% else %}
    <p>暂无文章。</p>
  {% endfor %}
</div>
